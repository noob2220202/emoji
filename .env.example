# BotFather에서 발급받은 봇 토큰 (@BotFather -> /newbot)
BOT_TOKEN=your_bot_token_here

# 이미지/GIF 하나를 대략 몇 조각(이모지)으로 나눌지에 대한 목표치. 원본 비율에 맞춰
# 이 개수에 가장 가까운 열x행 조합을 자동 계산합니다. 값을 늘리면 조각이 잘게 쪼개져
# 디테일은 살지만 다 이어붙였을 때 메시지가 커지고, 줄이면 조각 수(=결과물 크기)가
# 작아지는 대신 조각 하나하나가 뭉텅해집니다.
TARGET_TILE_COUNT=12

# 이모지 팩 하나당 최대 타일 개수 (텔레그램 자체 한도는 현재 200)
MAX_TILES=200

# 영상/GIF 이모지 최대 길이(초, 텔레그램 규격상 3초 이하)
MAX_VIDEO_DURATION=3

# 영상 이모지 하나의 최대 용량(바이트, 텔레그램 규격상 256KB 이하)
MAX_VIDEO_BYTES=262144

# 생성된 이모지에 매핑할 기본 연관 이모지 (그림 자체와는 무관, 검색용)
EMOJI_PLACEHOLDER=🙂

# 배경 제거(누끼)에 쓸 rembg 모델. u2netp(가볍고 빠름) / u2net / isnet-general-use(더 정확, 느림) 등
REMBG_MODEL=u2netp

# 이미지/GIF를 받았을 때 "배경 제거 후" 버튼을 보여줄지 여부
OFFER_BACKGROUND_REMOVAL=true

# 무료 횟수/이모지팩 목록을 저장하는 SQLite 파일 경로 (기본: 저장소 안 data/bot.db)
DB_PATH=./data/bot.db

# 하루 무료 횟수가 초기화되는 기준 시간대 (자정 기준으로 리셋)
QUOTA_TIMEZONE=Asia/Seoul

# 하루 무료 처리 횟수
FREE_IMAGE_PER_DAY=2
FREE_GIF_PER_DAY=1

# 무료 횟수를 다 쓴 뒤 텔레그램 Stars로 결제할 가격 (Stars 개수, 정수)
STAR_PRICE_IMAGE=10
STAR_PRICE_GIF=20
