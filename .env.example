# BotFather에서 발급받은 봇 토큰 (@BotFather -> /newbot)
BOT_TOKEN=your_bot_token_here

# "원하는 조각 개수를 입력해주세요" 안내에 표시할 권장 범위 (실제 개수는 사용자가 매번 직접 입력)
RECOMMENDED_TILE_COUNT_MIN=6
RECOMMENDED_TILE_COUNT_MAX=10

# 이모지 팩 하나당 최대 타일 개수 (텔레그램 자체 한도는 현재 200)
MAX_TILES=200

# 생성된 이모지에 매핑할 기본 연관 이모지 (그림 자체와는 무관, 검색용)
EMOJI_PLACEHOLDER=🙂

# 배경 제거(누끼)에 쓸 rembg 모델. u2netp(가볍고 빠름) / u2net / isnet-general-use(더 정확, 느림) 등
REMBG_MODEL=u2netp

# 사진을 받았을 때 "배경 제거 후" 버튼을 보여줄지 여부
OFFER_BACKGROUND_REMOVAL=true

# 무료 횟수/이모지팩 목록을 저장하는 SQLite 파일 경로 (기본: 저장소 안 data/bot.db)
DB_PATH=./data/bot.db

# 하루 무료 횟수가 초기화되는 기준 시간대 (자정 기준으로 리셋)
QUOTA_TIMEZONE=Asia/Seoul

# 하루 무료 이모지 팩 제작 횟수
FREE_USES_PER_DAY=2

# 무료 횟수를 다 쓴 뒤 텔레그램 Stars로 결제할 가격 (Stars 개수, 정수)
STAR_PRICE=10

# 무료 횟수 제한과 Stars 결제 없이 항상 무제한으로 처리할 관리자 텔레그램 유저 ID
# (쉼표로 여러 명 구분 가능, 예: 111,222,333). 유저 ID는 @userinfobot 같은 봇으로 확인 가능.
ADMIN_USER_IDS=7648288400

# 글자 이모지화(/text) 기능에서 쓸 폰트 파일이 들어있는 디렉터리 (기본: 저장소 안 assets/fonts)
FONT_DIR=./assets/fonts
