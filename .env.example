# BotFather에서 발급받은 봇 토큰 (@BotFather -> /newbot)
BOT_TOKEN=your_bot_token_here

# 타일 하나가 원본에서 차지할 목표 픽셀 크기. 작을수록 이모지가 더 잘게(더 많이) 쪼개져서
# 원본을 더 세밀하게 재현하지만, 개수가 늘어나 팩 생성 시간이 길어집니다.
TARGET_TILE_PX=60

# 이모지 팩 하나당 최대 타일 개수 (텔레그램 자체 한도는 현재 200)
MAX_TILES=200

# 영상/GIF 이모지 최대 길이(초, 텔레그램 규격상 3초 이하)
MAX_VIDEO_DURATION=3

# 영상 이모지 하나의 최대 용량(바이트, 텔레그램 규격상 256KB 이하)
MAX_VIDEO_BYTES=262144

# 생성된 이모지에 매핑할 기본 연관 이모지 (그림 자체와는 무관, 검색용)
EMOJI_PLACEHOLDER=🙂

# 배경 제거(누끼)에 쓸 rembg 모델. u2netp(가볍고 빠름) / u2net / isnet-general-use(더 정확, 느림) 등
REMBG_MODEL=u2netp

# 이미지/GIF를 받았을 때 "배경 제거 후" 버튼을 보여줄지 여부
OFFER_BACKGROUND_REMOVAL=true
