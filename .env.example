# BotFather에서 발급받은 봇 토큰 (@BotFather -> /newbot)
BOT_TOKEN=your_bot_token_here

# 타일 하나가 원본에서 차지할 목표 픽셀 크기. 작을수록 이모지 개수가 많아지고
# 원본을 더 세밀하게 재현하지만, 개수가 늘어나 팩 생성 시간이 길어집니다.
TARGET_TILE_PX=120

# 이모지 팩 하나당 최대 타일 개수 (텔레그램 자체 한도는 현재 200)
MAX_TILES=100

# 영상/GIF 이모지 최대 길이(초, 텔레그램 규격상 3초 이하)
MAX_VIDEO_DURATION=3

# 영상 이모지 하나의 최대 용량(바이트, 텔레그램 규격상 256KB 이하)
MAX_VIDEO_BYTES=262144

# 생성된 이모지에 매핑할 기본 연관 이모지 (그림 자체와는 무관, 검색용)
EMOJI_PLACEHOLDER=🙂
